{
	"useTabs": true,
	"tabWidth": 4,
	"semi": false,
	"singleQuote": true,
	"jsxSingleQuote": true,
	"trailingComma": "es5",
	"printWidth": 80,
	"endOfLine": "lf",
	"plugins": ["prettier-plugin-tailwindcss"],
	"tailwindStylesheet": "./src/index.css",
	"overrides": [
		{
			"files": "*.{yml,yaml}",
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}

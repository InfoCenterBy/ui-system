{
	"name": "ui-system",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.10.0",
	"scripts": {
		"dev": "pnpm --filter catalog dev",
		"build": "pnpm --filter catalog build",
		"preview": "pnpm --filter catalog preview",
		"test": "pnpm -r test",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "husky",
		"typecheck": "pnpm -r --if-present typecheck"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.13.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.0"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{css,json,md,html,yml}": "prettier --write"
	}
}
